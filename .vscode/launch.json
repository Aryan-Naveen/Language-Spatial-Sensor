{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Test Viz",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_viz.py",
      "console": "integratedTerminal",
      "args": [
        "--data_root",
        "~/mit/data/VLA-3D/VLA-3D_dataset",
        "--dataset",
        "scannet"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Preprocess (cache force rebuild)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/preprocess.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["cache.force_rebuild=true"]
    },
    {
      "name": "Python: Train (no W&B)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["wandb.enabled=false"]
    },
    {
      "name": "Eval: LSS Pipeline",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_pipeline.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": []
    },
    {
      "name": "Eval: LSS Pipeline (smoke test)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_pipeline.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "data.datasets=[Unity]",
        "hydra.run.dir=outputs/benchmarks/smoke_test"
      ]
    },
    {
      "name": "Eval: LSS Pipeline (cProfile)",
      "type": "python",
      "request": "launch",
      "module": "cProfile",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "-o", "outputs/profile.prof",
        "scripts/eval_pipeline.py",
        "data.datasets=[Unity]",
        "hydra.run.dir=outputs/benchmarks/profile_run"
      ]
    },
    {
      "name": "Eval: LSS Pipeline (named run)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_pipeline.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "hydra.run.dir=outputs/benchmarks/lss_v1",
        "checkpoint=checkpoints/best.pt"
      ]
    }
  ]
}