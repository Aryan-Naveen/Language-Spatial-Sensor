{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Test Viz",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_viz.py",
      "console": "integratedTerminal",
      "args": [
        "--data_root",
        "~/mit/data/VLA-3D/VLA-3D_dataset",
        "--dataset",
        "scannet"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Preprocess (cache force rebuild)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/preprocess.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["cache.force_rebuild=true"]
    },
    {
      "name": "Python: Train (no W&B)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["wandb.enabled=false"]
    }
  ]
}